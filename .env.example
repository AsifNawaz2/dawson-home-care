# Copy to .env.local for local overrides. Never commit real keys.

# Leads: "mock" saves submissions to ./.leads/*.json (git-ignored); "live" sends them to GoHighLevel.
LEAD_MODE=mock
# Live, option 1: GoHighLevel Inbound Webhook (workflow trigger). Wins when set.
GHL_WEBHOOK_URL=
# Live, option 2: API v2 contact upsert + note (Private Integration token, contacts.write scope).
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Spam protection: Cloudflare Turnstile, invisible. Off while empty (honeypot + duplicate guard
# still run). The site key turns the widget on; the secret key makes the server check its token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (none until launch)
NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only "true" on the real production domain. Everything else is noindex + robots Disallow.
NEXT_PUBLIC_INDEXABLE=false

# Show [[TO CONFIRM]] placeholders (preview + reveal). Set "false" to see the production view.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Logo figure: "a" (wheelchair, live) or "b" (two people, softened figure).
NEXT_PUBLIC_LOGO_FIGURE=a

# Lenis smooth scrolling — off by default (the approved design uses normal scrolling).
NEXT_PUBLIC_SMOOTH_SCROLL=false
